{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "CRI Common",
      "component": "ipv-cri-common-lambdas",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/code-quality.yml",
          "path": "$.jobs.pre-commit"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/code-quality.yml",
          "path": "$.jobs.linting"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            }
          ],
          "file": ".github/workflows/check-pr.yml",
          "path": "$.jobs.unit-tests-java"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            }
          ],
          "file": ".github/workflows/check-pr.yml",
          "path": "$.jobs.unit-tests-ts"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "contract"
            }
          ],
          "file": ".github/workflows/check-pr.yml",
          "path": "$.jobs.pact-tests-java"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "contract"
            }
          ],
          "file": ".github/workflows/check-pr.yml",
          "path": "$.jobs.pact-tests-ts"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "regression",
                "new feature"
              ]
            }
          ],
          "file": ".github/workflows/check-pr.yml",
          "path": "$.jobs.integration-tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/scan-repo.yml",
          "path": "$.jobs.sonarcloud-java"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/scan-repo.yml",
          "path": "$.jobs.sonarcloud-ts"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/scan-repo.yml",
          "path": "$.jobs.codeql"
        }
      ]
    }
  ]
}
